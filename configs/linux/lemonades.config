# OnePlus 9R (lemonades / SM8250) mainline config

# SM8250 SoC core: clocks, pinctrl, RPMh, SPMI, interconnects
CONFIG_ARCH_QCOM=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_SM_GCC_8250=y
CONFIG_SM_DISPCC_8250=y
CONFIG_SM_GPUCC_8250=y
CONFIG_SM_VIDEOCC_8250=y
CONFIG_SM_CAMCC_8250=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM8250=y
CONFIG_PINCTRL_SM8250_LPASS_LPI=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=n
CONFIG_QCOM_TZMEM_MODE_GENERIC=y
# CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE is not set
CONFIG_QCOM_PDR_HELPERS=y

# PON keys (power / volume down)
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y

# Crash log retention across reboots (pstore / ramoops)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# UFS storage + filesystems
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EFI_PARTITION=y

# USB 3.0 + OTG Dual-Role + Type-C + DisplayPort Alt-Mode + USB Gadget (NCM + ACM)
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_USB_HS=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_TYPEC_MUX_FSA4480=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Display & Touch: full MSM DRM (DPU + DSI + DP + Adreno A650) + AMB655X + S3908
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_PANEL_SAMSUNG_AMB655X=y
CONFIG_TOUCHSCREEN_SYNAPTICS_S3908=y
CONFIG_USB_TYPEC_DISPLAYPORT=y
CONFIG_DRM_AUX_HPD_BRIDGE=y
CONFIG_ZRAM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_REGULATOR_QCOM_REFGEN=y

# Battery / Power
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y

# Serial / UART
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# Remoteproc / Wi-Fi / Bluetooth (for Phase 3 bring-up)
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_MHI=y
CONFIG_MHI_BUS=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_INPUT_UINPUT=y

# Audio stack (QDSP6 + SoundWire + WCD938x)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QCOM_COMMON=y
CONFIG_SND_SOC_QCOM_SDW=y
CONFIG_SND_SOC_SM8250=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_QDSP6_CORE=y
CONFIG_SND_SOC_QDSP6_AFE=y
CONFIG_SND_SOC_QDSP6_AFE_DAI=y
CONFIG_SND_SOC_QDSP6_AFE_CLOCKS=y
CONFIG_SND_SOC_QDSP6_ADM=y
CONFIG_SND_SOC_QDSP6_ROUTING=y
CONFIG_SND_SOC_QDSP6_ASM=y
CONFIG_SND_SOC_QDSP6_ASM_DAI=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WCD938X_SDW=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_CLK_GFM_LPASS_SM8250=y
CONFIG_QCOM_APR=y
CONFIG_SND_SOC_LPASS_MACRO_COMMON=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SND_SOC_LPASS_WSA_MACRO=y
CONFIG_SND_SOC_QDSP6_COMMON=y
CONFIG_SND_SOC_QDSP6_APM=y
CONFIG_SND_SOC_QDSP6_APM_DAI=y
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=y
CONFIG_SND_SOC_QDSP6_PRM=y
CONFIG_SND_SOC_QDSP6_PRM_LPASS_CLOCKS=y

# Storage / compression / security
CONFIG_BLK_DEV_DM=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_SECURITY_LANDLOCK=y

# Networking for Tailscale / VPN / Firewall (TUN + policy routing + nftables/iptables)
CONFIG_TUN=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_MANGLE=y

# Remoteproc (ADSP / CDSP / MPSS) + FastRPC + PD Mapper + RMTFS
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_FASTRPC=y
CONFIG_QRTR_TUN=y

# Wi-Fi / Bluetooth QCA6390 power sequencing + PCIe MHI
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_MHI_BUS_PCI_GENERIC=y

# Audio LPASS pinctrl + Macros + WSA881X SoundWire speakers + SM8250 sound card
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_PINCTRL_SM8250_LPASS_LPI=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SND_SOC_WSA881X=y
CONFIG_SND_SOC_TFA987X=y
CONFIG_SND_SOC_DMIC=y
CONFIG_SND_SOC_HDMI_CODEC=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SOC_USB=y
CONFIG_SND_SOC_QCOM_OFFLOAD_UTILS=y
CONFIG_SND_SOC_QDSP6_USB=y
CONFIG_SND_SOC_QCOM_COMMON=y
CONFIG_SND_SOC_QCOM_SDW=y
CONFIG_SND_SOC_SM8250=y

# PMIC ADC5 / Thermal / Charger / QFPROM / SDAM / PDC reset
CONFIG_QCOM_VADC_COMMON=y
CONFIG_QCOM_SPMI_VADC=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_NVMEM_QCOM_SEC_QFPROM=y
CONFIG_NVMEM_QCOM_SPMI_SDAM=y
CONFIG_RESET_QCOM_PDC=y

# Droidloom Android cell runtime: private binderfs, PSI (lmkd), built-in veth
# cell networking and DMA-BUF heaps are boot-time requirements; they must be
# built in because this kernel ships without a /lib/modules tree.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y
CONFIG_VETH=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
