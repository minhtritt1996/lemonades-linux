# Base arm64 + console/earlycon/pstore config for lemonades-linux (ABL boot.img v2)
CONFIG_ARM64=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# SimpleDRM / SimpleFB for early panel output before DSI/DP probes
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_SERIAL_EARLYCON=y

# Console/logging
CONFIG_PRINTK=y
CONFIG_TTY=y

# Keep the build free of optional firmware/signing dependencies
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_MODULES=y

# Disable non-QCOM SoCs and unrelated DRM drivers so Image.gz fits comfortably under ramdisk_offset (15.96 MB)
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_TESLA_FSD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_ETNAVIV=n
CONFIG_DRM_LIMA=n
CONFIG_DRM_PANFROST=n
CONFIG_DRM_TEGRA=n
CONFIG_DRM_SUN4I=n
CONFIG_DRM_ROCKCHIP=n
CONFIG_DRM_MEDIATEK=n
CONFIG_DRM_MESON=n
CONFIG_DRM_EXYNOS=n
CONFIG_DRM_RCAR_DU=n
