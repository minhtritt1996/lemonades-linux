class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def _send(self, code, ctype, data):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _valid_origin(self):
        host = self.headers.get("Host", "")
        allowed_host = f"127.0.0.1:{LISTEN_PORT}"
        if host != allowed_host:
            return False
        origin = self.headers.get("Origin")
        if origin is not None and origin != f"http://{allowed_host}":
            return False
        return True

    def do_GET(self):
        if self.path == "/" or self.path.startswith("/?"):
            page = HTML.replace("__CSRF_TOKEN__", CSRF_TOKEN)
            self._send(200, "text/html; charset=utf-8", page.encode("utf-8"))
        elif self.path == "/api/state":
            self._send(200, "application/json", json.dumps(get_state()).encode("utf-8"))
        else:
            self._send(404, "text/plain", b"Not found")

    def do_POST(self):
        if self.path == "/api/apply":
            if not self._valid_origin() or not secrets.compare_digest(
                self.headers.get("X-CSRF-Token", ""), CSRF_TOKEN
            ):
                self._send(403, "application/json", json.dumps({"ok": False, "error": "Forbidden"}).encode("utf-8"))
                return
            try:
                n = int(self.headers.get("Content-Length", "0"))
                if n <= 0 or n > 4096:
                    self._send(400, "application/json", json.dumps({"ok": False, "error": "Invalid Content-Length"}).encode("utf-8"))
                    return
                body = json.loads(self.rfile.read(n).decode("utf-8"))
                if not isinstance(body, dict):
                    raise ValueError("Expected JSON object")
                apply_settings(
                    body.get("start_threshold", 75),
                    body.get("end_threshold", 80),
                    body.get("behaviour", "auto"),
                )
                self._send(200, "application/json", json.dumps({"ok": True}).encode("utf-8"))
            except (ValueError, UnicodeDecodeError) as e:
                self._send(400, "application/json", json.dumps({"ok": False, "error": str(e)}).encode("utf-8"))
            except Exception as e:
                self._send(500, "application/json", json.dumps({"ok": False, "error": str(e)}).encode("utf-8"))
        else:
            self._send(404, "text/plain", b"Not found")


def main():
    global LISTEN_PORT
    if len(sys.argv) > 1 and sys.argv[1] == "--apply-saved":
        vals = {}
        conf_file = CONF_PATH if os.path.isfile(CONF_PATH) else LEGACY_CONF_PATH
        if os.path.isfile(conf_file):
            with open(conf_file) as f:
                for line in f:
                    if "=" in line:
                        k, v = line.strip().split("=", 1)
                        vals[k] = v
            for _ in range(15):
                if os.path.isdir(CHG_DIR):
                    break
                time.sleep(0.2)
            if not os.path.isdir(CHG_DIR):
                print(f"WARNING: {CHG_DIR} not present; skipping charge-limit restore", file=sys.stderr)
                return
            apply_settings(vals.get("START", 75), vals.get("END", 80), vals.get("BEHAVIOUR", "auto"))
        return

    port = 18942
    already_running = False
    try:
        s_test = socket.create_connection(("127.0.0.1", port), timeout=0.3)
        s_test.close()
        already_running = True
    except OSError:
        already_running = False

    srv = None
    if not already_running:
        try:
            srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
        except OSError:
            sock = socket.socket()
            sock.bind(("127.0.0.1", 0))
            port = sock.getsockname()[1]
            sock.close()
            srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
        LISTEN_PORT = port
        t = threading.Thread(target=srv.serve_forever, daemon=True)
        t.start()
    else:
        LISTEN_PORT = port

    url = f"http://127.0.0.1:{port}"
    browser = shutil.which("chromium") or shutil.which("chromium-browser") or shutil.which("firefox")
    if browser and "chromium" in os.path.basename(browser):
        profile_dir = os.path.join(os.path.expanduser("~"), ".cache", "lemonades-charge-gui-profile")
        os.makedirs(profile_dir, exist_ok=True)
        p = subprocess.Popen([
            browser,
            f"--user-data-dir={profile_dir}",
            "--no-first-run",
            "--no-default-browser-check",
            f"--app={url}",
            "--window-size=440,700",
            "--class=lemonades-charge-limit",
        ])
        p.wait()
        if srv is not None:
            srv.shutdown()
    elif browser and "firefox" in os.path.basename(browser):
        p = subprocess.Popen([browser, "--new-window", url])
        p.wait()
        if srv is not None:
            srv.shutdown()
    else:
        print(f"Charge Limit GUI running at {url}")
        try:
            while True:
                time.sleep(1)
        except KeyboardInterrupt:
            if srv is not None:
                srv.shutdown()


if __name__ == "__main__":
    main()
