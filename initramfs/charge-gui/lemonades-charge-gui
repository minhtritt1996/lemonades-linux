#!/usr/bin/env python3
"""OnePlus 9R (lemonades) Charge Limit & Battery Bypass GUI.

Zero external dependencies: runs a local HTTP server bound to 127.0.0.1 and
opens Chromium in native --app window mode. Exits automatically when closed.
"""
import json
import os
import secrets
import shutil
import socket
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CHG_DIR = "/sys/class/power_supply/mp2650-charger"
BAT_DIR = "/sys/class/power_supply/bq27541-0"
CONF_PATH = "/etc/lemonades/charge-limit/charge-limit.conf"
LEGACY_CONF_PATH = "/etc/lemonades/charge-limit.conf"
CSRF_TOKEN = secrets.token_urlsafe(24)
LISTEN_PORT = 18942


def read_str(path, default=""):
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except OSError:
        return default


def read_int(path, default=0):
    try:
        return int(read_str(path))
    except (ValueError, TypeError):
        return default


def write_str(path, val):
    with open(path, "w") as f:
        f.write(str(val) + "\n")


def find_pd_dir():
    base = "/sys/class/power_supply"
    try:
        for name in os.listdir(base):
            if name.startswith("tcpm-source-psy-"):
                return os.path.join(base, name)
    except OSError:
        pass
    return None


def parse_behaviour(raw):
    # sysfs returns e.g. "[auto] inhibit-charge" or "auto [inhibit-charge]"
    for tok in raw.split():
        if tok.startswith("[") and tok.endswith("]"):
            return tok[1:-1]
    return raw or "auto"


def get_state():
    pd_dir = find_pd_dir()
    pd_v = read_int(os.path.join(pd_dir, "voltage_now")) / 1e6 if pd_dir else 0.0
    pd_i = read_int(os.path.join(pd_dir, "current_now")) / 1e6 if pd_dir else 0.0
    pd_on = read_int(os.path.join(pd_dir, "online")) if pd_dir else 0

    chg_present = os.path.isdir(CHG_DIR)
    behaviour = parse_behaviour(read_str(os.path.join(CHG_DIR, "charge_behaviour")))
    start_thr = read_int(os.path.join(CHG_DIR, "charge_control_start_threshold"), 75)
    end_thr = read_int(os.path.join(CHG_DIR, "charge_control_end_threshold"), 80)
    hw_on = read_int(os.path.join(CHG_DIR, "hw_charge_enabled"), 1)
    chg_status = read_str(os.path.join(CHG_DIR, "status"), "Unknown")

    return {
        "driver_ok": chg_present,
        "capacity": read_int(os.path.join(BAT_DIR, "capacity"), -1),
        "bat_status": read_str(os.path.join(BAT_DIR, "status"), "Unknown"),
        "bat_voltage_v": round(read_int(os.path.join(BAT_DIR, "voltage_now")) / 1e6, 2),
        "bat_current_ma": round(read_int(os.path.join(BAT_DIR, "current_now")) / 1e3, 1),
        "pd_online": bool(pd_on),
        "pd_voltage_v": round(pd_v, 1),
        "pd_current_a": round(pd_i, 2),
        "behaviour": behaviour,
        "start_threshold": start_thr,
        "end_threshold": end_thr,
        "hw_charging_enabled": bool(hw_on),
        "chg_status": chg_status,
    }


def apply_settings(start_thr, end_thr, behaviour):
    start_thr = max(20, min(95, int(start_thr)))
    end_thr = max(40, min(100, int(end_thr)))
    if start_thr >= end_thr and end_thr < 100:
        start_thr = max(20, end_thr - 5)
    if behaviour not in ("auto", "inhibit-charge"):
        behaviour = "auto"

    write_str(os.path.join(CHG_DIR, "charge_control_end_threshold"), end_thr)
    write_str(os.path.join(CHG_DIR, "charge_control_start_threshold"), start_thr)
    write_str(os.path.join(CHG_DIR, "charge_behaviour"), behaviour)

    try:
        os.makedirs(os.path.dirname(CONF_PATH), exist_ok=True)
        with open(CONF_PATH, "w") as f:
            f.write(f"START={start_thr}\nEND={end_thr}\nBEHAVIOUR={behaviour}\n")
    except OSError:
        pass


