[Unit]
Description=External SDX55M 5G modem bring-up (SAHARA images + EFS sync)
After=systemd-udevd.service tqftpserv.service
Wants=tqftpserv.service
ConditionPathExists=/sys/bus/mhi/devices/mhi0

[Service]
Type=simple
ExecStart=/usr/local/sbin/lemonades-sdx55-modem.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
